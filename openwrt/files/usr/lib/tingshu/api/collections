#!/bin/sh
#
# 听书 · 合集同步接口（uhttpd CGI）
#
#   GET  /cgi-ts/collections        → {"ok":true,"data":[...]}
#   POST /cgi-ts/collections        → body: c=<urlencoded JSON>（整个合集列表）
#
# 数据放在 /etc/tingshu/users/<用户>/collections.json（overlay，重启不丢）
# 合集数量少、且总是整体读写，所以用单个文件存整个列表。
#

. "${TINGSHU_LIB_DIR:-/usr/lib/tingshu}/auth.sh"
ts_require_auth

DATA_FILE="${TINGSHU_COLLECTIONS_FILE:-$TS_USERS_DIR/$TS_USER/collections.json}"

method="${REQUEST_METHOD:-GET}"

# ---- POST ----
if [ "$method" = "POST" ]; then
	ts_read_body 524288 || ts_fail 413 "too large"
	c="$(ts_urldecode "$(ts_param "$TS_BODY" c)")"

	# 必须是 JSON 数组或对象
	case "$c" in
		'{'*'}'|'['*']') ;;
		*) ts_fail 400 "bad payload" ;;
	esac
	# 解码后再卡一次体积（urlencode 会让请求体膨胀）
	[ ${#c} -le 262144 ] || ts_fail 413 "too large"

	mkdir -p "$(dirname "$DATA_FILE")" 2>/dev/null
	printf '%s' "$c" | ts_write_atomic "$DATA_FILE" || ts_fail 500 "write failed"
	ts_ok ""
fi

# ---- GET ----
ts_header
if [ -f "$DATA_FILE" ]; then
	printf '{"ok":true,"data":'
	cat "$DATA_FILE"
	printf '}\n'
else
	printf '{"ok":true,"data":[]}\n'
fi
exit 0

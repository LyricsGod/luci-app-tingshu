#!/bin/sh
#
# 听书 · 进度同步接口（uhttpd CGI）
#
#   GET  /cgi-ts/progress            → {"ok":true,"items":{"<hexId>":{...}}}
#   GET  /cgi-ts/progress?b=<hexId>  → 单本
#   POST /cgi-ts/progress            → body: b=<hexId>&i=<章>&t=<秒>&d=<0,1>&u=<时间戳>
#
# 数据放在 /etc/tingshu/users/<用户>/progress/<hexId>.json（overlay，重启不丢）
# 书 id 由前端转成十六进制，这里只接受 [0-9a-f]，避免任何路径/注入问题。
#

. /usr/lib/tingshu/auth.sh
ts_require_auth

DATA_DIR="${TINGSHU_PROGRESS_DIR:-$TS_USERS_DIR/$TS_USER/progress}"
mkdir -p "$DATA_DIR" 2>/dev/null

method="${REQUEST_METHOD:-GET}"

# ---- POST：写一本进度 ----
if [ "$method" = "POST" ]; then
	ts_read_body 65536 || ts_fail 413 "too large"

	b="$(ts_param "$TS_BODY" b)"
	i="$(ts_param "$TS_BODY" i)"
	t="$(ts_param "$TS_BODY" t)"
	d="$(ts_param "$TS_BODY" d)"
	u="$(ts_param "$TS_BODY" u)"

	ts_is_hex "$b" || ts_fail 400 "bad id"
	[ ${#b} -le 400 ] || ts_fail 400 "id too long"
	ts_is_uint "$i" || ts_fail 400 "bad index"
	case "$t" in ''|*[!0-9.]*) ts_fail 400 "bad time" ;; esac
	ts_is_uint "$u" || ts_fail 400 "bad ts"
	case "$d" in *[!0-9,]*) ts_fail 400 "bad done" ;; esac

	printf '{"index":%s,"time":%s,"done":[%s],"updatedAt":%s}' "$i" "$t" "$d" "$u" \
		| ts_write_atomic "$DATA_DIR/$b.json" || ts_fail 500 "write failed"
	ts_ok ""
fi

# ---- GET ----
one="$(ts_param "${QUERY_STRING:-}" b)"

if [ -n "$one" ]; then
	ts_is_hex "$one" || ts_fail 400 "bad id"
	if [ -f "$DATA_DIR/$one.json" ]; then
		printf '{"ok":true,"items":{"%s":' "$one"
		cat "$DATA_DIR/$one.json"
		printf '}}\n'
	else
		printf '{"ok":true,"items":{}}\n'
	fi
	exit 0
fi

printf '{"ok":true,"items":{'
first=1
for f in "$DATA_DIR"/*.json; do
	[ -f "$f" ] || continue
	k="${f##*/}"
	k="${k%.json}"
	ts_is_hex "$k" || continue
	[ "$first" -eq 1 ] || printf ','
	first=0
	printf '"%s":' "$k"
	cat "$f"
done
printf '}}\n'
exit 0

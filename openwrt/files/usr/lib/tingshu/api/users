#!/bin/sh
#
# 听书 · 用户管理（仅管理员）
#
#   GET  /cgi-ts/users                 → {ok, users:[{user,role,created}]}
#   POST /cgi-ts/users?action=create   u=&p=&role=user|admin
#   POST /cgi-ts/users?action=reset    u=&p=
#   POST /cgi-ts/users?action=delete   u=
#

. "${TINGSHU_LIB_DIR:-/usr/lib/tingshu}/auth.sh"
ts_require_admin

method="${REQUEST_METHOD:-GET}"
action="$(ts_param "${QUERY_STRING:-}" action)"

# ---- GET：用户列表 ----
if [ "$method" = "GET" ]; then
	list=""
	sep=""
	for f in "$TS_USERS_DIR"/*/account; do
		[ -f "$f" ] || continue
		name="${f%/account}"
		name="${name##*/}"
		role="$(ts_user_role "$name")"
		created="$(sed -n 's/^created=//p' "$f" | head -n 1)"
		list="$list$sep{\"user\":\"$name\",\"role\":\"$role\",\"created\":${created:-0}}"
		sep=","
	done
	ts_ok ",\"users\":[$list]"
fi

[ "$method" = "POST" ] || ts_fail 400 "post required"
ts_read_body 16384 || ts_fail 413 "too large"
body="$TS_BODY"

# 串行化，防止两个管理员同时建同名用户
exec 9>/tmp/tingshu-users.lock
flock 9 2>/dev/null

case "$action" in

create)
	u="$(ts_urldecode "$(ts_param "$body" u)")"
	p="$(ts_urldecode "$(ts_param "$body" p)")"
	role="$(ts_urldecode "$(ts_param "$body" role)")"
	[ -n "$role" ] || role=user

	ts_create_user "$u" "$p" "$role"
	case $? in
		0) ;;
		2) ts_fail 400 "用户名只能包含字母、数字、下划线和横线（1-32 位）" ;;
		3) ts_fail 400 "用户名已存在" ;;
		4) ts_fail 400 "密码至少 6 位" ;;
		5) ts_fail 400 "角色只能是 admin 或 user" ;;
		*) ts_fail 500 "创建失败" ;;
	esac
	ts_ok ""
	;;

reset)
	u="$(ts_urldecode "$(ts_param "$body" u)")"
	p="$(ts_urldecode "$(ts_param "$body" p)")"
	ts_user_exists "$u" || ts_fail 404 "用户不存在"

	ts_set_password "$u" "$p"
	case $? in
		0) ;;
		4) ts_fail 400 "密码至少 6 位" ;;
		*) ts_fail 500 "保存失败" ;;
	esac
	ts_delete_sessions_for "$u"
	ts_ok ""
	;;

delete)
	u="$(ts_urldecode "$(ts_param "$body" u)")"
	ts_user_exists "$u" || ts_fail 404 "用户不存在"
	[ "$u" = "$TS_USER" ] && ts_fail 400 "不能删除当前登录的账号"

	if [ "$(ts_user_role "$u")" = "admin" ] && [ "$(ts_count_admins)" -le 1 ]; then
		ts_fail 400 "至少保留一个管理员"
	fi

	ts_delete_user_data "$u"
	ts_ok ""
	;;

*)
	ts_fail 400 "unknown action"
	;;
esac
exit 0

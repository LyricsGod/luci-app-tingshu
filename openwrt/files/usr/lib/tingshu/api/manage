#!/bin/sh
#
# 听书 · 书库管理接口（uhttpd CGI）
#
#   POST ?action=upload&p=<urlenc 相对路径>   请求体 = 文件内容，写入 书架/相对路径
#   POST ?action=archive&n=<urlenc 文件名>    请求体 = 压缩包，解压进书架目录
#   POST ?action=delete&b=<urlenc 相对目录>   删除 书架/相对目录
#   POST ?action=rescan                       重新扫描并生成 library.json
#
# 只允许音频/图片/文本类文件；路径一律拒绝 .. 和绝对路径。
#

. /usr/lib/tingshu/auth.sh
ts_require_admin

BOOKS_DIR="${TINGSHU_BOOKS_DIR:-}"
WWW_DIR="${TINGSHU_WWW_DIR:-/tmp/tingshu/www}"

if [ -z "$BOOKS_DIR" ]; then
	if [ -f /lib/functions.sh ] && [ -f /etc/config/tingshu ]; then
		. /lib/functions.sh
		config_load tingshu
		config_get BOOKS_DIR main books_dir /mnt/audiobooks
	else
		BOOKS_DIR=/mnt/audiobooks
	fi
fi

# 相对路径合法性：非空、非绝对、任何一段都不能是 ..
safe_rel() {
	[ -n "$1" ] || return 1
	case "$1" in /*) return 1 ;; esac
	case "/$1/" in */../*) return 1 ;; esac
	return 0
}

# 文件体积校验：$1 = 路径，$2 = 期望字节数（0 表示不校验）
size_ok() {
	local want have
	want="${2:-0}"
	ts_is_uint "$want" || want=0
	[ "$want" = "0" ] && return 0
	have=$(wc -c < "$1" 2>/dev/null | tr -d ' ')
	[ "$want" = "$have" ]
}

action="$(ts_param "${QUERY_STRING:-}" action)"
[ -n "$action" ] || ts_fail 400 "no action"

[ -d "$BOOKS_DIR" ] || ts_fail 400 "books dir missing"

case "$action" in

upload)
	rel="$(ts_urldecode "$(ts_param "$QUERY_STRING" p)")"
	safe_rel "$rel" || ts_fail 400 "bad path"

	# 只允许音视频/图片/文本，避免往书库里丢可执行文件
	ext=$(printf '%s' "$rel" | sed 's/.*\.//' | tr 'A-Z' 'a-z')
	case "$ext" in
		mp3|m4a|m4b|aac|ogg|oga|opus|wav|flac|webm|ape|wma|\
		jpg|jpeg|png|webp|gif|bmp|\
		txt|nfo|m3u|m3u8|json|srt|lrc) ;;
		*) ts_fail 400 "unsupported type: $ext" ;;
	esac

	target="$BOOKS_DIR/$rel"
	mkdir -p "$(dirname "$target")" 2>/dev/null || ts_fail 500 "mkdir failed"

	# 先写临时文件，校验完整后再替换，避免半截文件留在书库
	tmp="$target.part.$$"
	cat > "$tmp" 2>/dev/null || { rm -f "$tmp"; ts_fail 500 "write failed"; }
	if ! size_ok "$tmp" "${CONTENT_LENGTH:-0}"; then
		rm -f "$tmp"
		ts_fail 400 "incomplete upload"
	fi
	mv -f "$tmp" "$target" 2>/dev/null || { rm -f "$tmp"; ts_fail 500 "rename failed"; }

	ts_ok ",\"size\":$(wc -c < "$target" | tr -d ' ')"
	;;

archive)
	name="$(ts_urldecode "$(ts_param "$QUERY_STRING" n)")"
	ext=$(printf '%s' "$name" | sed 's/.*\.//' | tr 'A-Z' 'a-z')
	case "$ext" in
		zip|tar|gz|tgz) ;;
		*) ts_fail 400 "unsupported archive: $ext" ;;
	esac

	tmp="/tmp/tingshu-up.$$"
	cat > "$tmp" 2>/dev/null || { rm -f "$tmp"; ts_fail 500 "upload failed"; }
	if ! size_ok "$tmp" "${CONTENT_LENGTH:-0}"; then
		rm -f "$tmp"
		ts_fail 400 "incomplete upload"
	fi

	# 先解到临时目录，再把顶层内容并进书库
	stage="/tmp/tingshu-stage.$$"
	mkdir -p "$stage" 2>/dev/null

	if [ "$ext" = "zip" ]; then
		unzip -q -o "$tmp" -d "$stage" 2>/dev/null || { rm -rf "$tmp" "$stage"; ts_fail 500 "unzip failed"; }
	else
		tar -xf "$tmp" -C "$stage" 2>/dev/null || { rm -rf "$tmp" "$stage"; ts_fail 500 "untar failed"; }
	fi
	rm -f "$tmp"

	moved=0
	for f in "$stage"/* "$stage"/.[!.]*; do
		[ -e "$f" ] || continue
		base=$(basename "$f")
		case "$base" in
			__MACOSX|.DS_Store|desktop.ini) continue ;;
		esac
		rm -rf "$BOOKS_DIR/$base" 2>/dev/null
		mv "$f" "$BOOKS_DIR/" 2>/dev/null && moved=$((moved + 1))
	done
	rm -rf "$stage"

	[ "$moved" -gt 0 ] || ts_fail 500 "nothing extracted"
	ts_ok ",\"items\":$moved"
	;;

delete)
	rel="$(ts_urldecode "$(ts_param "$QUERY_STRING" b)")"
	safe_rel "$rel" || ts_fail 400 "bad path"

	target="$BOOKS_DIR/$rel"
	[ -e "$target" ] || ts_fail 404 "not found"

	# 解析真实路径，确认没被软链带到书库外面
	real=$(readlink -f "$target" 2>/dev/null)
	root=$(readlink -f "$BOOKS_DIR" 2>/dev/null)
	case "$real" in
		"$root"/*) ;;
		*) ts_fail 400 "outside books dir" ;;
	esac

	rm -rf "$target" 2>/dev/null || ts_fail 500 "delete failed"
	ts_ok ""
	;;

rescan)
	out=$(TINGSHU_WWW_DIR="$WWW_DIR" /usr/lib/tingshu/scan.sh 2>/dev/null | tail -n 1)
	books=$(printf '%s' "$out" | sed -n 's/.*"books":\([0-9]*\).*/\1/p')
	tracks=$(printf '%s' "$out" | sed -n 's/.*"tracks":\([0-9]*\).*/\1/p')
	ts_ok ",\"books\":${books:-0},\"tracks\":${tracks:-0}"
	;;

*)
	ts_fail 400 "unknown action"
	;;
esac

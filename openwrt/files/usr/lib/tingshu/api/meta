#!/bin/sh
#
# 听书 · 书籍元数据同步接口（uhttpd CGI）
#   书名 / 简介 / 配色 / 封面，多端同步
#
#   GET  /cgi-ts/meta           → {"ok":true,"items":{"<hexId>":{...}}}
#   GET  /cgi-ts/meta?b=<hexId> → 单本
#   POST /cgi-ts/meta           → body 是 JSON：{id:<hexId>,title,desc,palette,cover(base64),coverType,updatedAt}
#
# 数据放在 /etc/tingshu/meta/<hexId>.json：书籍是全局共享的，所以不按用户分目录。
# 封面以 base64 存进 json（书籍封面通常几百 KB，可接受）。
#

. "${TINGSHU_LIB_DIR:-/usr/lib/tingshu}/auth.sh"
ts_require_auth

DATA_DIR="${TINGSHU_META_DIR:-/etc/tingshu/meta}"
mkdir -p "$DATA_DIR" 2>/dev/null

method="${REQUEST_METHOD:-GET}"

# ---- POST：只有管理员能改书名/封面 ----
if [ "$method" = "POST" ]; then
	[ "$TS_ROLE" = "admin" ] || ts_fail 403 "forbidden"
	ts_read_body 2097152 || ts_fail 413 "too large"     # 上限 2MB

	id="$(printf '%s' "$TS_BODY" | sed -n 's/.*"id":"\([0-9a-f]*\)".*/\1/p')"
	ts_is_hex "$id" || ts_fail 400 "bad id"
	[ ${#id} -le 400 ] || ts_fail 400 "id too long"

	case "$TS_BODY" in
		'{'*'}') ;;
		*) ts_fail 400 "bad payload" ;;
	esac

	printf '%s' "$TS_BODY" | ts_write_atomic "$DATA_DIR/$id.json" || ts_fail 500 "write failed"
	ts_ok ""
fi

# ---- GET ----
one="$(ts_param "${QUERY_STRING:-}" b)"

if [ -n "$one" ]; then
	ts_is_hex "$one" || ts_fail 400 "bad id"
	ts_header
	if [ -f "$DATA_DIR/$one.json" ]; then
		printf '{"ok":true,"items":{"%s":' "$one"
		cat "$DATA_DIR/$one.json"
		printf '}}\n'
	else
		printf '{"ok":true,"items":{}}\n'
	fi
	exit 0
fi

ts_header
printf '{"ok":true,"items":{'
first=1
for f in "$DATA_DIR"/*.json; do
	[ -f "$f" ] || continue
	k="${f##*/}"
	k="${k%.json}"
	ts_is_hex "$k" || continue
	[ "$first" -eq 1 ] || printf ','
	first=0
	printf '"%s":' "$k"
	cat "$f"
done
printf '}}\n'
exit 0

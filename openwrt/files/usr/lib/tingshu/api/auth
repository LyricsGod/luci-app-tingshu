#!/bin/sh
#
# 听书 · 登录 / 初始化管理员 / 退出
#
#   GET  /cgi-ts/auth?action=status    → {configured, authenticated, user, role}
#   POST /cgi-ts/auth?action=setup     u=&p=     仅在没有用户时可用，创建管理员
#   POST /cgi-ts/auth?action=login     u=&p=
#   POST /cgi-ts/auth?action=logout
#   POST /cgi-ts/auth?action=password  old=&p=   修改自己的密码
#

. "${TINGSHU_LIB_DIR:-/usr/lib/tingshu}/auth.sh"

method="${REQUEST_METHOD:-GET}"
body=""
if [ "$method" = "POST" ]; then
	ts_read_body 16384 || ts_fail 413 "too large"
	body="$TS_BODY"
fi

action="$(ts_param "${QUERY_STRING:-}" action)"
[ -n "$action" ] || action=status

case "$action" in

status)
	configured=false
	[ "$(ts_user_count)" -gt 0 ] && configured=true

	authed=false
	user=""
	role=""
	if ts_load_session; then
		authed=true
		user="$TS_USER"
		role="$TS_ROLE"
	fi

	ts_ok "$(printf ',"configured":%s,"authenticated":%s,"user":"%s","role":"%s"' \
		"$configured" "$authed" "$user" "$role")"
	;;

setup)
	[ "$method" = "POST" ] || ts_fail 400 "post required"
	[ "$(ts_user_count)" -eq 0 ] || ts_fail 403 "already configured"

	u="$(ts_urldecode "$(ts_param "$body" u)")"
	p="$(ts_urldecode "$(ts_param "$body" p)")"
	ts_safe_name "$u" || ts_fail 400 "用户名只能包含字母、数字、下划线和横线（1-32 位）"

	ts_create_user "$u" "$p" admin
	case $? in
		0) ;;
		3) ts_fail 400 "用户名已存在" ;;
		4) ts_fail 400 "密码至少 6 位" ;;
		*) ts_fail 500 "创建失败，请检查磁盘空间" ;;
	esac

	ts_migrate_legacy "$u"
	token="$(ts_create_session "$u" admin)" || ts_fail 500 "创建会话失败"
	ts_set_cookie "$token"
	ts_ok "$(printf ',"user":"%s","role":"admin","token":"%s"' "$u" "$token")"
	;;

login)
	[ "$method" = "POST" ] || ts_fail 400 "post required"

	u="$(ts_urldecode "$(ts_param "$body" u)")"
	p="$(ts_urldecode "$(ts_param "$body" p)")"
	if ! ts_check_password "$u" "$p"; then
		sleep 1        # 简单的暴力破解减速
		ts_fail 401 "用户名或密码不对"
	fi

	role="$(ts_user_role "$u")"
	token="$(ts_create_session "$u" "$role")" || ts_fail 500 "创建会话失败"
	ts_set_cookie "$token"
	ts_ok "$(printf ',"user":"%s","role":"%s","token":"%s"' "$u" "$role" "$token")"
	;;

logout)
	token="$(ts_token_from_request)"
	case "$token" in
		''|*[!0-9a-fA-F]*) ;;
		*) [ ${#token} -eq 64 ] && rm -f "$TS_SESSION_DIR/$token" ;;
	esac
	ts_clear_cookie
	ts_ok ""
	;;

password)
	[ "$method" = "POST" ] || ts_fail 400 "post required"
	ts_require_auth

	old="$(ts_urldecode "$(ts_param "$body" old)")"
	new="$(ts_urldecode "$(ts_param "$body" p)")"
	ts_check_password "$TS_USER" "$old" || ts_fail 400 "原密码不对"

	ts_set_password "$TS_USER" "$new"
	case $? in
		0) ;;
		4) ts_fail 400 "新密码至少 6 位" ;;
		*) ts_fail 500 "保存失败" ;;
	esac
	ts_ok ""
	;;

*)
	ts_fail 400 "unknown action"
	;;
esac
exit 0

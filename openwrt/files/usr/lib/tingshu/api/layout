#!/bin/sh
#
# 听书 · 每个用户的页面布局
#
#   GET  /cgi-ts/layout   → {"ok":true,"layout":{"columns":2}}
#   POST /cgi-ts/layout   → body 是 JSON 对象，例如 {"columns":3}
#

. "${TINGSHU_LIB_DIR:-/usr/lib/tingshu}/auth.sh"
ts_require_auth

DATA_FILE="$TS_USERS_DIR/$TS_USER/layout.json"
method="${REQUEST_METHOD:-GET}"

# ---- POST ----
if [ "$method" = "POST" ]; then
	ts_read_body 8192 || ts_fail 413 "too large"

	case "$TS_BODY" in
		'{'*'}') ;;
		*) ts_fail 400 "bad payload" ;;
	esac

	mkdir -p "$(dirname "$DATA_FILE")" 2>/dev/null
	printf '%s' "$TS_BODY" | ts_write_atomic "$DATA_FILE" || ts_fail 500 "write failed"
	ts_ok ""
fi

# ---- GET ----
ts_header
if [ -f "$DATA_FILE" ]; then
	printf '{"ok":true,"layout":'
	cat "$DATA_FILE"
	printf '}\n'
else
	printf '{"ok":true,"layout":{"columns":0}}\n'
fi
exit 0

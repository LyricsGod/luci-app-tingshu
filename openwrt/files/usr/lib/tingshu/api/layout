#!/bin/sh
#
# 听书 · 每个用户的页面布局
#
#   GET  /cgi-ts/layout   → {"ok":true,"layout":{"columns":2}}
#   POST /cgi-ts/layout   → body 是 JSON 对象，例如 {"columns":3}
#
. /usr/lib/tingshu/auth.sh

hdr() {
	printf 'Content-Type: application/json; charset=utf-8\r\n'
	printf 'Cache-Control: no-store\r\n'
	printf 'X-Content-Type-Options: nosniff\r\n'
	printf '\r\n'
}

ts_require_auth

DATA_FILE="$TS_USERS_DIR/$TS_USER/layout.json"
method="${REQUEST_METHOD:-GET}"

if [ "$method" = "POST" ]; then
	len="${CONTENT_LENGTH:-0}"
	case "$len" in ''|*[!0-9]*) len=0 ;; esac
	[ "$len" -le 8192 ] || { hdr; printf '{"ok":false,"error":"too large"}\n'; exit 0; }
	body=""
	[ "$len" -gt 0 ] && body="$(head -c "$len")"
	case "$body" in
		'{'*'}') ;;
		*) hdr; printf '{"ok":false,"error":"bad payload"}\n'; exit 0 ;;
	esac
	dir="$(dirname "$DATA_FILE")"
	mkdir -p "$dir" 2>/dev/null
	tmp="$DATA_FILE.$$"
	printf '%s' "$body" > "$tmp" 2>/dev/null
	if [ $? -ne 0 ]; then
		rm -f "$tmp" 2>/dev/null
		hdr; printf '{"ok":false,"error":"write failed"}\n'; exit 0
	fi
	mv -f "$tmp" "$DATA_FILE" 2>/dev/null
	if [ $? -ne 0 ]; then
		rm -f "$tmp" 2>/dev/null
		hdr; printf '{"ok":false,"error":"rename failed"}\n'; exit 0
	fi
	hdr
	printf '{"ok":true}\n'
	exit 0
fi

hdr
if [ -f "$DATA_FILE" ]; then
	printf '{"ok":true,"layout":'
	cat "$DATA_FILE"
	printf '}\n'
else
	printf '{"ok":true,"layout":{"columns":0}}\n'
fi
exit 0

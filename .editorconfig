# 统一编辑器行为，避免 CRLF 破坏 shell shebang 之类的问题
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,css,html,json,webmanifest,yml,yaml,svg}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 110

[*.{kt,kts}]
indent_size = 4

[*.{sh,service}]
indent_style = tab
indent_size = 4

[openwrt/files/etc/init.d/*]
indent_style = tab

# 打包脚本与 CI 里的 heredoc 需要原样保留
[*.md]
trim_trailing_whitespace = false
